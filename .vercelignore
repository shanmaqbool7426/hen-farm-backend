# Vercel's Node.js zero-config detection only recognizes a fixed list of
# entrypoint filenames: app|index|server .{js,cjs,mjs,ts,cts,mts}, at the
# root or under src/. It picks whichever of those it finds FIRST - it does
# NOT consult package.json's "start" script. server.mjs (root, committed,
# pre-built by build.mjs) is the one we want it to find. Everything below is
# excluded specifically so nothing else in that search list is visible -
# src/app.ts kept getting found and compiled unbundled instead, which is the
# exact bug (directory-import crash) server.mjs exists to avoid.
src
dist
api
_vercel-src
build.mjs
build-vercel.mjs
*.md
*.txt
add-buyer-ali.js
add-seller-shan.js
create-admin.mjs
hash-passwords.mjs
migrate-roles.mjs
seed-demo.mjs
seed-sellers.js
setup-test-data.js
setup-users.js
test-api.mjs
test-connection.mjs
test-p2p-marketplace.mjs
tmp-test-mongo.js
update-seller-tiers.mjs
.replit-artifact
