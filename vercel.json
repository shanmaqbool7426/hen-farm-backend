{
  "buildCommand": "node build-vercel.mjs",
  "crons": [
    {
      "path": "/api/cron/daily-eggs",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler"
    },
    {
      "source": "/",
      "destination": "/api/handler"
    }
  ]
}
